# Banco PostgreSQL
DATABASE_URL="postgresql://maisi9:maisi9@localhost:5432/maisi9?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
# Necessário quando o app roda atrás de proxy/Docker (self-hosted)
AUTH_TRUST_HOST="true"

# Login Microsoft 365 (Entra ID) — registrar o app no portal do Azure:
#   Redirect URI: https://<endereço-do-app>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# Pasta de arquivos enviados (no Docker: volume em /app/storage)
STORAGE_DIR="./storage"

# E-mails que viram Administrador no primeiro login (separados por vírgula)
ADMIN_EMAILS=""

# Login sem senha para desenvolvimento local. NUNCA "true" em produção.
AUTH_DEV_LOGIN="false"

# Endereço público do app (links nos e-mails)
APP_URL="http://localhost:3000"

# E-mail dos alertas (SMTP). Microsoft 365: smtp.office365.com, porta 587, conta com SMTP AUTH liberado.
# Sem SMTP_HOST a rotina só simula (nada é enviado).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Segredo da rotina diária de alertas (POST /api/tarefas/alertas com "Authorization: Bearer <segredo>")
CRON_SECRET=""

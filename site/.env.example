# Endereço público do site (canônicas, sitemap, Open Graph). Lido no build.
NEXT_PUBLIC_SITE_URL="https://www.maisi9.com.br"

# Libera a indexação pelos buscadores (robots e meta robots). Lido no build.
# Deixe "false" em testes e homologação; "true" só na publicação oficial.
SITE_INDEXAVEL="false"

# ---- Destino dos leads (formulários) -------------------------------------
# Configure ao menos um canal. Sem nenhum, o formulário avisa o visitante
# que a mensagem NÃO foi enviada.

# 1) Webhook: recebe POST com o lead em JSON (CRM, automação, n8n, Make, Zapier…)
LEADS_WEBHOOK_URL=""
# Opcional: enviado como "Authorization: Bearer <token>"
LEADS_WEBHOOK_TOKEN=""

# 2) E-mail para a equipe comercial (vários endereços separados por vírgula)
LEADS_EMAIL_PARA=""
# SMTP (Microsoft 365: smtp.office365.com, porta 587, conta com SMTP AUTH liberado)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Remetente; se vazio, usa SMTP_USER
SMTP_FROM=""

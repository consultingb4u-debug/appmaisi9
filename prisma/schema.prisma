// Modelo de dados — MAIS i9 Gestão de Projetos, Portfólio e Recursos
// Referência funcional: docs/01-proposta-arquitetura.md (seção C)
// Incremento 1: cadastros, segurança, calendário e auditoria.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Segurança ─────────────────────────────

enum Perfil {
  ADMIN
  GESTOR
  CONSULTOR
  VISUALIZADOR
}

model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  nome          String
  email         String    @unique
  perfil        Perfil    @default(VISUALIZADOR)
  ativo         Boolean   @default(true)
  ultimoAcesso  DateTime? @map("ultimo_acesso")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  recurso       Recurso?
  auditorias    Auditoria[]

  @@map("usuario")
}

// ───────────────────────────── Recursos ─────────────────────────────

enum TipoRecurso {
  INTERNO
  TERCEIRO
}

model Recurso {
  id              String      @id @default(uuid()) @db.Uuid
  usuarioId       String?     @unique @map("usuario_id") @db.Uuid
  nome            String      @unique
  email           String?     @unique
  cargo           String?
  area            String?
  tipo            TipoRecurso @default(INTERNO)
  ativo           Boolean     @default(true)
  dataEntrada     DateTime?   @map("data_entrada") @db.Date
  dataSaida       DateTime?   @map("data_saida") @db.Date
  criadoEm        DateTime    @default(now()) @map("criado_em")
  criadoPorId     String?     @map("criado_por_id") @db.Uuid
  atualizadoEm    DateTime    @updatedAt @map("atualizado_em")
  atualizadoPorId String?     @map("atualizado_por_id") @db.Uuid

  usuario         Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  apelidos        RecursoApelido[]
  capacidades     RecursoCapacidade[]
  projetosGp      Projeto[]            @relation("ProjetoGp")
  participacoes   ProjetoMembro[]
  alocacoes       AlocacaoSemanal[]
  indisponibilidades Indisponibilidade[]
  atribuicoes     AtividadeAtribuicao[]
  apontamentos    Apontamento[]
  backlogResponsavel BacklogItem[]      @relation("BacklogResponsavel")
  atividadesResponsavel Atividade[]     @relation("AtividadeResponsavel")

  @@map("recurso")
}

/// Grafias alternativas usadas nas planilhas ("Dornelles", "Laura Iris").
/// Usado pela importação para resolver nomes automaticamente.
model RecursoApelido {
  id        String  @id @default(uuid()) @db.Uuid
  recursoId String  @map("recurso_id") @db.Uuid
  apelido   String  @unique

  recurso   Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@map("recurso_apelido")
}

/// Capacidade semanal com vigência. vigenciaFim nula = vigente.
model RecursoCapacidade {
  id              String    @id @default(uuid()) @db.Uuid
  recursoId       String    @map("recurso_id") @db.Uuid
  vigenciaInicio  DateTime  @map("vigencia_inicio") @db.Date
  vigenciaFim     DateTime? @map("vigencia_fim") @db.Date
  horasSemanais   Decimal   @map("horas_semanais") @db.Decimal(5, 1)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  criadoPorId     String?   @map("criado_por_id") @db.Uuid

  recurso         Recurso   @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@index([recursoId, vigenciaInicio])
  @@map("recurso_capacidade")
}

// ───────────────────────────── Clientes ─────────────────────────────

model Cliente {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String    @unique
  razaoSocial     String?   @map("razao_social")
  segmento        String?
  ativo           Boolean   @default(true)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  criadoPorId     String?   @map("criado_por_id") @db.Uuid
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId String?   @map("atualizado_por_id") @db.Uuid

  contatos        ContatoCliente[]
  apelidos        ClienteApelido[]
  projetos        Projeto[]

  @@map("cliente")
}

enum FuncaoContato {
  SPONSOR
  GP_CLIENTE
  KEY_USER
  TI
  OUTRO
}

model ContatoCliente {
  id              String        @id @default(uuid()) @db.Uuid
  clienteId       String        @map("cliente_id") @db.Uuid
  nome            String
  email           String?
  telefone        String?
  funcao          FuncaoContato @default(OUTRO)
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em")

  cliente         Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  atividades      Atividade[]

  @@unique([clienteId, nome])
  @@map("contato_cliente")
}

/// Grafias alternativas do cliente nas planilhas ("DIPIL" → Dipil).
model ClienteApelido {
  id        String  @id @default(uuid()) @db.Uuid
  clienteId String  @map("cliente_id") @db.Uuid
  apelido   String  @unique

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("cliente_apelido")
}

// ───────────────────────────── Projetos ─────────────────────────────

enum TipoProjeto {
  PROJETO
  SUPORTE
  SUSTENTACAO
  ALOCACAO
  INTERNO
}

enum StatusProjeto {
  PROJETO_IDENTIFICADO
  APROVACAO_CLIENTE
  NAO_APROVADO
  EM_ANDAMENTO
  BLOQUEADO
  CONCLUIDO
  CANCELADO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusExecutivo {
  VERDE
  AMARELO
  VERMELHO
}

enum FaseProjeto {
  ENVISIONING
  DEVELOPMENT
  DEPLOYMENT
  POST_DEPLOY
}

model Projeto {
  id                        String           @id @default(uuid()) @db.Uuid
  codigo                    String           @unique
  clienteId                 String           @map("cliente_id") @db.Uuid
  nome                      String
  tipo                      TipoProjeto      @default(PROJETO)
  status                    StatusProjeto    @default(EM_ANDAMENTO)
  prioridade                Prioridade       @default(MEDIA)
  gpId                      String?          @map("gp_id") @db.Uuid
  dataKickoff               DateTime?        @map("data_kickoff") @db.Date
  dataGoLiveAlvo            DateTime?        @map("data_go_live_alvo") @db.Date
  dataGoLiveReal            DateTime?        @map("data_go_live_real") @db.Date
  dataEncerramentoPrevista  DateTime?        @map("data_encerramento_prevista") @db.Date
  dataEncerramentoReal      DateTime?        @map("data_encerramento_real") @db.Date
  horasVendidas             Decimal?         @map("horas_vendidas") @db.Decimal(8, 1)
  notas                     String?
  statusExecutivo           StatusExecutivo? @map("status_executivo")
  faseAtual                 FaseProjeto?     @map("fase_atual")
  arquivadoEm               DateTime?        @map("arquivado_em")
  criadoEm                  DateTime         @default(now()) @map("criado_em")
  criadoPorId               String?          @map("criado_por_id") @db.Uuid
  atualizadoEm              DateTime         @updatedAt @map("atualizado_em")
  atualizadoPorId           String?          @map("atualizado_por_id") @db.Uuid

  cliente                   Cliente          @relation(fields: [clienteId], references: [id])
  gp                        Recurso?         @relation("ProjetoGp", fields: [gpId], references: [id], onDelete: SetNull)
  membros                   ProjetoMembro[]
  alocacoes                 AlocacaoSemanal[]
  backlog                   BacklogItem[]
  atividades                Atividade[]
  apontamentos              Apontamento[]

  @@unique([clienteId, nome])
  @@index([status])
  @@map("projeto")
}

enum PapelProjeto {
  GP
  FUNCIONAL
  TECNICO
  DEV
  ANALISTA
  APOIO
}

model ProjetoMembro {
  id        String       @id @default(uuid()) @db.Uuid
  projetoId String       @map("projeto_id") @db.Uuid
  recursoId String       @map("recurso_id") @db.Uuid
  papel     PapelProjeto
  inicio    DateTime?    @db.Date
  fim       DateTime?    @db.Date
  criadoEm  DateTime     @default(now()) @map("criado_em")

  projeto   Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  recurso   Recurso      @relation(fields: [recursoId], references: [id])

  @@unique([projetoId, recursoId, papel])
  @@map("projeto_membro")
}

// ───────────────────────────── Backlog e cronograma ─────────────────────────────

enum TipoBacklog {
  ENTREGA
  REQUISITO
  MELHORIA
  INTEGRACAO
  RELATORIO
  CUSTOMIZACAO
}

enum AderenciaPadrao {
  ADERENTE
  PARCIAL
  GAP
  A_VALIDAR
}

enum SimNaoAConfirmar {
  SIM
  NAO
  A_CONFIRMAR
}

enum StatusItem {
  NAO_INICIADO
  EM_ANDAMENTO
  BLOQUEADO
  CONCLUIDO
  CANCELADO
}

enum Validacao {
  PENDENTE
  APROVADO
  REPROVADO
  NA
}

model BacklogItem {
  id               String           @id @default(uuid()) @db.Uuid
  projetoId        String           @map("projeto_id") @db.Uuid
  codigo           String
  moduloProcesso   String?          @map("modulo_processo")
  requisito        String
  tipo             TipoBacklog      @default(ENTREGA)
  prioridade       Prioridade       @default(MEDIA)
  aderenciaPadrao  AderenciaPadrao  @default(A_VALIDAR) @map("aderencia_padrao")
  solucaoProposta  String?          @map("solucao_proposta")
  customizacao     SimNaoAConfirmar @default(A_CONFIRMAR)
  criterioAceite   String?          @map("criterio_aceite")
  estimativaHoras  Decimal?         @map("estimativa_horas") @db.Decimal(7, 1)
  responsavelId    String?          @map("responsavel_id") @db.Uuid
  status           StatusItem       @default(NAO_INICIADO)
  validacaoCliente Validacao        @default(PENDENTE) @map("validacao_cliente")
  observacao       String?
  ordem            Int              @default(0)
  importLinhaId    String?          @map("import_linha_id") @db.Uuid
  criadoEm         DateTime         @default(now()) @map("criado_em")
  criadoPorId      String?          @map("criado_por_id") @db.Uuid
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em")
  atualizadoPorId  String?          @map("atualizado_por_id") @db.Uuid

  projeto          Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  responsavel      Recurso?         @relation("BacklogResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  atividades       Atividade[]

  @@unique([projetoId, codigo])
  @@map("backlog_item")
}

/// Atividade do cronograma (CRON-001). Esforço, realizado e forecast são somas das atribuições/apontamentos.
model Atividade {
  id                  String       @id @default(uuid()) @db.Uuid
  projetoId           String       @map("projeto_id") @db.Uuid
  codigo              String
  fase                FaseProjeto
  backlogItemId       String?      @map("backlog_item_id") @db.Uuid
  tarefa              String
  moduloProcesso      String?      @map("modulo_processo")
  responsavelId       String?      @map("responsavel_id") @db.Uuid
  contatoClienteId    String?      @map("contato_cliente_id") @db.Uuid
  clienteParticipa    Boolean      @default(false) @map("cliente_participa")
  inicioPrevisto      DateTime?    @map("inicio_previsto") @db.Date
  fimPrevisto         DateTime?    @map("fim_previsto") @db.Date
  percentualConclusao Int          @default(0) @map("percentual_conclusao")
  status              StatusItem   @default(NAO_INICIADO)
  marco               Boolean      @default(false)
  dataRealConclusao   DateTime?    @map("data_real_conclusao") @db.Date
  observacao          String?
  ordem               Int          @default(0)
  importLinhaId       String?      @map("import_linha_id") @db.Uuid
  criadoEm            DateTime     @default(now()) @map("criado_em")
  criadoPorId         String?      @map("criado_por_id") @db.Uuid
  atualizadoEm        DateTime     @updatedAt @map("atualizado_em")
  atualizadoPorId     String?      @map("atualizado_por_id") @db.Uuid

  projeto             Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  backlogItem         BacklogItem? @relation(fields: [backlogItemId], references: [id], onDelete: SetNull)
  responsavel         Recurso?     @relation("AtividadeResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  contatoCliente      ContatoCliente? @relation(fields: [contatoClienteId], references: [id], onDelete: SetNull)
  atribuicoes         AtividadeAtribuicao[]
  predecessoras       AtividadePredecessora[] @relation("Sucessora")
  sucessoras          AtividadePredecessora[] @relation("Predecessora")
  apontamentos        Apontamento[]

  @@unique([projetoId, codigo])
  @@index([projetoId, fase])
  @@map("atividade")
}

/// Quem executa a atividade e com quanto esforço (substitui as linhas CRON-xxx.2/.3 da planilha).
model AtividadeAtribuicao {
  id                String    @id @default(uuid()) @db.Uuid
  atividadeId       String    @map("atividade_id") @db.Uuid
  recursoId         String    @map("recurso_id") @db.Uuid
  esforcoPrevisto   Decimal   @default(0) @map("esforco_previsto") @db.Decimal(7, 1)
  horasParaConcluir Decimal?  @map("horas_para_concluir") @db.Decimal(7, 1)

  atividade         Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  recurso           Recurso   @relation(fields: [recursoId], references: [id])
  rateio            AtribuicaoSemana[]

  @@unique([atividadeId, recursoId])
  @@map("atividade_atribuicao")
}

/// Distribuição automática das horas da atribuição nas semanas (explica as horas calculadas da alocação).
model AtribuicaoSemana {
  atribuicaoId    String              @map("atribuicao_id") @db.Uuid
  semanaId        String              @map("semana_id")
  horasCalculadas Decimal             @map("horas_calculadas") @db.Decimal(6, 1)

  atribuicao      AtividadeAtribuicao @relation(fields: [atribuicaoId], references: [id], onDelete: Cascade)
  semana          Semana              @relation(fields: [semanaId], references: [id])

  @@id([atribuicaoId, semanaId])
  @@map("atribuicao_semana")
}

model AtividadePredecessora {
  atividadeId    String    @map("atividade_id") @db.Uuid
  predecessoraId String    @map("predecessora_id") @db.Uuid

  atividade      Atividade @relation("Sucessora", fields: [atividadeId], references: [id], onDelete: Cascade)
  predecessora   Atividade @relation("Predecessora", fields: [predecessoraId], references: [id], onDelete: Cascade)

  @@id([atividadeId, predecessoraId])
  @@map("atividade_predecessora")
}

/// Horas realizadas: cada pessoa aponta por atividade e semana (atividade nula = projeto sem cronograma).
model Apontamento {
  id           String     @id @default(uuid()) @db.Uuid
  recursoId    String     @map("recurso_id") @db.Uuid
  projetoId    String     @map("projeto_id") @db.Uuid
  atividadeId  String?    @map("atividade_id") @db.Uuid
  semanaId     String     @map("semana_id")
  horas        Decimal    @db.Decimal(5, 1)
  descricao    String?
  criadoEm     DateTime   @default(now()) @map("criado_em")
  criadoPorId  String?    @map("criado_por_id") @db.Uuid
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  recurso      Recurso    @relation(fields: [recursoId], references: [id])
  projeto      Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  atividade    Atividade? @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  semana       Semana     @relation(fields: [semanaId], references: [id])

  @@index([recursoId, semanaId])
  @@index([atividadeId])
  @@index([projetoId, recursoId, semanaId])
  @@map("apontamento")
}

// ───────────────────────────── Alocação e disponibilidade ─────────────────────────────

enum StatusAlocacao {
  PLANEJADO
  EM_ANDAMENTO
  BLOQUEADO
  AGUARDANDO_CLIENTE
  CONCLUIDO
  CANCELADO
}

/// Unidade do planejamento: Projeto + Recurso + Semana.
/// Previstas = coalesce(horasManuais, horasCalculadas) + horasAvulsas.
model AlocacaoSemanal {
  id               String         @id @default(uuid()) @db.Uuid
  projetoId        String         @map("projeto_id") @db.Uuid
  recursoId        String         @map("recurso_id") @db.Uuid
  semanaId         String         @map("semana_id")
  horasCalculadas  Decimal        @default(0) @map("horas_calculadas") @db.Decimal(6, 1)
  horasManuais     Decimal?       @map("horas_manuais") @db.Decimal(6, 1)
  horasAvulsas     Decimal        @default(0) @map("horas_avulsas") @db.Decimal(6, 1)
  horasRealizadas  Decimal        @default(0) @map("horas_realizadas") @db.Decimal(6, 1)
  status           StatusAlocacao @default(PLANEJADO)
  prioridade       Prioridade?
  observacao       String?
  importLinhaId    String?        @map("import_linha_id") @db.Uuid
  criadoEm         DateTime       @default(now()) @map("criado_em")
  criadoPorId      String?        @map("criado_por_id") @db.Uuid
  atualizadoEm     DateTime       @updatedAt @map("atualizado_em")
  atualizadoPorId  String?        @map("atualizado_por_id") @db.Uuid

  projeto          Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  recurso          Recurso        @relation(fields: [recursoId], references: [id])
  semana           Semana         @relation(fields: [semanaId], references: [id])

  @@unique([projetoId, recursoId, semanaId])
  @@index([recursoId, semanaId])
  @@map("alocacao_semanal")
}

enum TipoIndisponibilidade {
  FERIAS
  FERIADO_LOCAL
  AUSENCIA
  TREINAMENTO
  BLOQUEIO
  OUTROS
}

enum StatusIndisponibilidade {
  PENDENTE
  APROVADA
  RECUSADA
}

model Indisponibilidade {
  id              String                  @id @default(uuid()) @db.Uuid
  recursoId       String                  @map("recurso_id") @db.Uuid
  tipo            TipoIndisponibilidade
  inicio          DateTime                @db.Date
  fim             DateTime                @db.Date
  horasPorDia     Decimal?                @map("horas_por_dia") @db.Decimal(4, 1)
  observacao      String?
  status          StatusIndisponibilidade @default(PENDENTE)
  importLinhaId   String?                 @map("import_linha_id") @db.Uuid
  criadoEm        DateTime                @default(now()) @map("criado_em")
  criadoPorId     String?                 @map("criado_por_id") @db.Uuid
  atualizadoEm    DateTime                @updatedAt @map("atualizado_em")

  recurso         Recurso                 @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@index([recursoId, inicio])
  @@map("indisponibilidade")
}

// ───────────────────────────── Importação ─────────────────────────────

enum TipoImportacao {
  CTRL003
  CTRL001
}

enum StatusLote {
  CARREGADO
  VALIDADO
  COM_ERROS
  EFETIVADO
  DESCARTADO
}

enum AcaoImportacao {
  CRIAR
  ATUALIZAR
  IGNORAR
}

enum StatusLinha {
  OK
  ALERTA
  ERRO
}

model ImportLote {
  id            String         @id @default(uuid()) @db.Uuid
  tipo          TipoImportacao
  projetoId     String?        @map("projeto_id") @db.Uuid
  arquivoNome   String         @map("arquivo_nome")
  arquivoChave  String         @map("arquivo_chave")
  status        StatusLote     @default(CARREGADO)
  resumo        String?
  carregadoPorId String?       @map("carregado_por_id") @db.Uuid
  carregadoEm   DateTime       @default(now()) @map("carregado_em")
  efetivadoPorId String?       @map("efetivado_por_id") @db.Uuid
  efetivadoEm   DateTime?      @map("efetivado_em")

  linhas        ImportLinha[]

  @@map("import_lote")
}

/// Staging: cada linha relevante da planilha, com os dados brutos em JSON.
model ImportLinha {
  id               String          @id @default(uuid()) @db.Uuid
  loteId           String          @map("lote_id") @db.Uuid
  aba              String
  linhaOrigem      Int             @map("linha_origem")
  entidade         String
  chave            String
  dados            Json
  acao             AcaoImportacao?
  status           StatusLinha?
  entidadeIdDestino String?        @map("entidade_id_destino")

  lote             ImportLote      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  mensagens        ImportMensagem[]

  @@index([loteId, aba])
  @@map("import_linha")
}

model ImportMensagem {
  id       String      @id @default(uuid()) @db.Uuid
  linhaId  String      @map("linha_id") @db.Uuid
  nivel    StatusLinha
  campo    String?
  mensagem String

  linha    ImportLinha @relation(fields: [linhaId], references: [id], onDelete: Cascade)

  @@map("import_mensagem")
}

// ───────────────────────────── Calendário ─────────────────────────────

enum AbrangenciaFeriado {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

model Feriado {
  id          String             @id @default(uuid()) @db.Uuid
  data        DateTime           @db.Date
  descricao   String
  abrangencia AbrangenciaFeriado @default(NACIONAL)
  uf          String?            @db.Char(2)
  municipio   String?
  criadoEm    DateTime           @default(now()) @map("criado_em")

  @@unique([data, abrangencia, descricao])
  @@map("feriado")
}

/// Semana ISO (segunda a domingo). id no formato "2026-W40".
model Semana {
  id      String   @id
  anoIso  Int      @map("ano_iso")
  numero  Int
  inicio  DateTime @unique @db.Date
  fim     DateTime @db.Date

  alocacoes    AlocacaoSemanal[]
  rateios      AtribuicaoSemana[]
  apontamentos Apontamento[]

  @@unique([anoIso, numero])
  @@map("semana")
}

// ───────────────────────────── Auditoria ─────────────────────────────

enum AcaoAuditoria {
  CRIAR
  ALTERAR
  EXCLUIR
  IMPORTAR
  PUBLICAR
}

/// Log imutável. `alteracoes` guarda {campo: [antes, depois]}.
model Auditoria {
  id         String        @id @default(uuid()) @db.Uuid
  entidade   String
  entidadeId String        @map("entidade_id")
  projetoId  String?       @map("projeto_id") @db.Uuid
  acao       AcaoAuditoria
  usuarioId  String?       @map("usuario_id") @db.Uuid
  dataHora   DateTime      @default(now()) @map("data_hora")
  resumo     String?
  alteracoes Json?

  usuario    Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([projetoId])
  @@index([dataHora])
  @@map("auditoria")
}
